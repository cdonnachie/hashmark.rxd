# ── HashMark configuration ──────────────────────────────────
#
# Every value here is PUBLIC. HashMark holds no secrets: no private keys, no
# database credentials, no API tokens, no accounts. If something ever needs to
# be kept secret, it does not belong in this application.
#
# NEXT_PUBLIC_ values are inlined at build time. Set them BEFORE `pnpm build`,
# not just at runtime.

# The origin visitors actually reach the site on.
#
# Used to origin-bind the wallet callback: Photonic only returns a result to a
# `callback` whose origin exactly matches the `origin` we declare. In the
# browser the live origin is used instead, so a preview deployment binds
# correctly rather than pointing at production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Radiant nodes ───────────────────────────────────────────
# Comma-separated ElectrumX WebSocket endpoints, tried in order.
#
# Only nodes running RXinDexer belong here. Beyond the standard ElectrumX
# methods, the browser needs `refs` on a UTXO (so coin selection can skip
# token-bearing outputs the wallet would refuse to sign) and
# `wave.reverse_lookup` (for the names shown beside a connected wallet). A
# general-purpose Radiant node answers neither.
#
# Fingerprint search does not use these sockets at all — see HASHMARK_INDEX_URL.
#
# Every server is checked on connect: one reporting a genesis hash other than
# Radiant mainnet's is refused, so a wrong endpoint cannot serve testnet data
# as if it were mainnet.
#
# This list also generates the CSP `connect-src`, so adding a server needs a
# rebuild, not just a restart.
NEXT_PUBLIC_ELECTRUM_SERVERS="wss://electrumx.rxd-radiant.com:50011,wss://electrumx-eu.rxd-radiant.com:50011"

# ── Digest index ────────────────────────────────────────────
# Base URL of the RXinDexer REST API that serves HashMark digest lookups
# (`GET /hashmark/{digest}` and `GET /hashmark/stats`).
#
# Searching by fingerprint is the one thing a plain Radiant node cannot do, so
# without this /verify reports "search is unavailable" — which is deliberately
# not the same as "no mark found". Verification by transaction id or receipt
# works with or without it.
#
# NOT a NEXT_PUBLIC_ value, on purpose: the indexer sits on a private network
# and its address is never shipped to a browser. Read at runtime, so changing it
# needs a restart but not a rebuild. Browsers reach the index only through this
# application's /api/hashmarks/* routes, and re-verify every hit against a
# Radiant node themselves, so the index is never trusted for an answer.
#
# Check the wiring with `curl -s http://localhost:3000/api/health` — the
# `search` field reads "ok", "unavailable" or "not-configured".
# HASHMARK_INDEX_URL="http://10.0.0.5:8000"

# ── Wallet ──────────────────────────────────────────────────
# Photonic's hosted wallet. `#/connect` is a web hash route, not a custom URL
# scheme. Override to point at a locally running Photonic during development,
# e.g. "http://localhost:5173/#/connect".
NEXT_PUBLIC_PHOTONIC_CONNECT_URL="https://photonic-wallet.com/#/connect"

# ── Explorer ────────────────────────────────────────────────
# Link pattern only. HashMark never fetches from an explorer, it only links out,
# so bot protection on the explorer does not affect anything here.
NEXT_PUBLIC_EXPLORER_TX_URL="https://explorer2.rxd-radiant.com/tx/{txid}"

# ── Fees ────────────────────────────────────────────────────
# Photons per byte. Matches Photonic's own default rather than the node's much
# lower relay minimum: the wallet applies its own fee-sanity check before
# signing, and a transaction priced below what it expects risks being refused
# at the approval screen. A typical mark costs a few hundredths of an RXD.
NEXT_PUBLIC_FEE_RATE="10000"

# ── Optional ────────────────────────────────────────────────
# Where the production server listens. The reverse proxy must point at the same
# value. Defaults to 3000 and 0.0.0.0.
# PORT="3000"
# HOSTNAME="0.0.0.0"
